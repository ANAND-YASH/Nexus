{
  "name": "@nexus/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier configuration for NEXUS",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint/base": "./eslint/base.js",
    "./prettier": "./prettier.js"
  },
  "files": [
    "tsconfig",
    "eslint",
    "prettier.js"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.0"
  }
}

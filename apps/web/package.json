{
  "name": "@nexus/web",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS web client (Next.js App Router)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@nexus/types": "workspace:*",
    "@nexus/ui": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@nexus/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}

{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS backend API (NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "db:migration:generate": "sh -c 'typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate --pretty \"src/database/migrations/${1:?Usage: pnpm db:migration:generate <MigrationName>}\"' --",
    "db:migration:create": "sh -c 'typeorm-ts-node-commonjs migration:create \"src/database/migrations/${1:?Usage: pnpm db:migration:create <MigrationName>}\"' --",
    "db:migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "db:migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "db:migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "db:migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "@nexus/types": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "openai": "7.28.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@nexus/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "~6.0.3"
  }
}

# Copy to .env and adjust. Never commit .env.
# Both apps and docker compose read this single root file.

# ── Runtime ────────────────────────────────────────────
# Next.js sets this itself; the API defaults to "development". Set in production.
# NODE_ENV=development

# ── API (apps/api) ─────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API from the browser.
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ─────────────────────────────────────
# Server-side base URL the web app uses to reach the API.
API_URL=http://localhost:4000

# ── PostgreSQL ─────────────────────────────────────────
# Required. Used by the API (TypeORM), the migration CLI, and docker compose
# (which initialises the container from these on first start).
# Local development values only — use a secret manager in production.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=nexus
DATABASE_PASSWORD=change_me
DATABASE_NAME=nexus

# ── Redis (docker/docker-compose.yml) ──────────────────
REDIS_PORT=6379
# Not consumed yet.
REDIS_URL=redis://localhost:6379

# Copy to .env and adjust. Never commit .env.
# Both apps and docker compose read this single root file.

# ── Runtime ────────────────────────────────────────────
# Next.js sets this itself; the API defaults to "development". Set in production.
# NODE_ENV=development

# ── API (apps/api) ─────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API from the browser.
CORS_ORIGIN=http://localhost:3000

# ── Authentication (apps/api) ─────────────────────────
# Required. Two DIFFERENT secrets, each at least 32 characters.
# Generate each with: openssl rand -base64 48
# Left blank on purpose so the API refuses to start until you set them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes: seconds, or a duration like 15m, 12h, 7d.
# Access tokens are short-lived (they can't be revoked before they expire).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Web (apps/web) ─────────────────────────────────────
# Server-side base URL the web app uses to reach the API.
API_URL=http://localhost:4000

# ── PostgreSQL ─────────────────────────────────────────
# Required. Used by the API (TypeORM), the migration CLI, and docker compose
# (which initialises the container from these on first start).
# Local development values only — use a secret manager in production.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=nexus
DATABASE_PASSWORD=change_me
DATABASE_NAME=nexus

# ── Redis (docker/docker-compose.yml) ──────────────────
REDIS_PORT=6379
# BullMQ queue for AI document analysis (required when it is enabled).
REDIS_URL=redis://localhost:6379

# ── AI / OpenAI ──────────────────────────────────────────
# Opt-in. When false (default), no Redis connection or AI provider is used
# and POST /api/documents/:id/analyze returns 503.
AI_DOCUMENT_ANALYSIS_ENABLED=false
# Required when enabled (must start with "sk-"). Never commit a real key.
OPENAI_API_KEY=

# Model used for document analysis.
AI_DOCUMENT_ANALYSIS_MODEL=gpt-4o-mini

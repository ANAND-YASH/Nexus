# Copy to .env and adjust. Never commit .env.
# Both apps and docker compose read this single root file.

# ── Runtime ────────────────────────────────────────────
# Next.js sets this itself; the API defaults to "development". Set in production.
# NODE_ENV=development

# ── API (apps/api) ─────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API from the browser.
CORS_ORIGIN=http://localhost:3000

# ── Web (apps/web) ─────────────────────────────────────
# Server-side base URL the web app uses to reach the API.
API_URL=http://localhost:4000

# ── PostgreSQL (docker/docker-compose.yml) ─────────────
# Local development credentials only — use a secret manager in production.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nexus
POSTGRES_PORT=5432
# Not consumed yet; wired up when the database layer lands.
DATABASE_URL=postgresql://nexus:change_me@localhost:5432/nexus

# ── Redis (docker/docker-compose.yml) ──────────────────
REDIS_PORT=6379
# Not consumed yet.
REDIS_URL=redis://localhost:6379
